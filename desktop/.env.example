# Aerchain (Groq-only build) — runtime config. Never commit this file.
# Copied from .env.example on first run; anything already exported in your
# shell wins over values here.

# Groq key pool (REQUIRED for AerBot answers — free at console.groq.com/keys).
# The first key serves; on rate limits the next key takes over automatically.
# Add more anytime: comma-separated here, or in Settings → Groq cloud.
KTQ_GROQ_KEYS=

# Groq endpoint + model (defaults are correct — uncomment only if Groq moves them):
# KTQ_LLM_URL=https://api.groq.com/openai/v1
# KTQ_LLM_MODEL=openai/gpt-oss-120b

# OCR language for scanned uploads (tesseract codes, + to combine):
# KTQ_OCR_LANG=eng

# Per-question safety cap, seconds (slow/junk runs fail fast with guidance):
# KTQ_AGENT_BUDGET_S=240

# Shared browser password (empty = open, no login):
# KTQ_APP_PASSWORD=
